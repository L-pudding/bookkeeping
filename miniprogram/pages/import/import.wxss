/* pages/import/import.wxss */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.section-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.step-label {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
  color: #333;
}

.picker-display {
  background: #f5f5f5;
  border-radius: 10rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
}

.format-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.format-option {
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 20rpx;
}

.format-option.active {
  border-color: #4a90d9;
  background: #e8f1fc;
}

.format-name {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.format-desc {
  font-size: 22rpx;
  color: #999;
}

.upload-btn {
  text-align: center;
  padding: 36rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  border: 2rpx dashed #ccc;
  font-size: 28rpx;
  color: #666;
}

.file-hint {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 12rpx;
}

/* 预览区 */
.preview-card { border-left: 6rpx solid #4a90d9; }

.preview-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.preview-total {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.preview-list {
  border-top: 1rpx solid #f0f0f0;
}

.preview-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.pr-type {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.pr-type.expense { background: #fde8e8; color: #e74c3c; }
.pr-type.income { background: #d5f0db; color: #27ae60; }

.pr-info {
  flex: 1;
}

.pr-merchant {
  font-size: 28rpx;
  color: #333;
}

.pr-date {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 2rpx;
}

.pr-amount {
  font-size: 28rpx;
  font-weight: 600;
}

.pr-amount.expense { color: #e74c3c; }
.pr-amount.income { color: #27ae60; }

/* 结果 */
.result-card { border-left: 6rpx solid #4a90d9; }

.result-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.result-row {
  font-size: 26rpx;
  padding: 6rpx 0;
  color: #333;
}

.result-row.warn { color: #e67e22; }
.result-row.error { color: #e74c3c; }
