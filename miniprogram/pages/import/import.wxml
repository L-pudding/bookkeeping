<!-- pages/import/import.wxml -->
<view class="container">
  <view class="card">
    <view class="section-title">导入账单</view>
    <view class="section-desc">支持 CSV 和 Excel(.xlsx/.xls) 文件，系统自动去重（指纹匹配）后入库，重复的交易不会重复记录。</view>
  </view>

  <!-- 步骤1：选账户 -->
  <view class="card">
    <view class="step-label">① 选择导入到哪个账户</view>
    <picker mode="selector" range="{{accountNames}}" value="{{accountIdx}}" bindchange="onAccountChange">
      <view class="picker-display">{{accountNames[accountIdx]}}</view>
    </picker>
  </view>

  <!-- 步骤2：选格式 -->
  <view class="card">
    <view class="step-label">② 选择账单格式</view>
    <view class="format-options">
      <view
        wx:for="{{formats}}"
        wx:key="value"
        class="format-option {{selectedFormat === item.value ? 'active' : ''}}"
        bindtap="selectFormat"
        data-format="{{item.value}}"
      >
        <view class="format-name">{{item.label}}</view>
        <view class="format-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- 步骤3：上传文件 -->
  <view class="card">
    <view class="step-label">③ 选择账单文件（CSV 或 Excel）</view>
    <view class="upload-btn" bindtap="chooseFile">
      <text wx:if="{{!fileName}}">点击选择文件</text>
      <text wx:else>{{fileName}}</text>
    </view>
    <view class="file-hint">支持 .csv / .xlsx / .xls 格式</view>
  </view>

  <!-- 预览解析结果 -->
  <view class="card preview-card" wx:if="{{parsedRecords}}">
    <view class="preview-title">解析结果预览</view>
    <view class="preview-total">共 {{parsedRecords.total}} 条记录{{parsedRecords.total > 20 ? '（下方显示前 20 条）' : ''}}</view>

    <view class="preview-list">
      <view class="preview-row" wx:for="{{parsedRecords.preview}}" wx:key="index">
        <view class="pr-type {{item.type}}">{{item.type === 'income' ? '收' : '支'}}</view>
        <view class="pr-info">
          <view class="pr-merchant">{{item.merchant || '(无商户)'}}</view>
          <view class="pr-date">{{item.dateStr}}</view>
        </view>
        <view class="pr-amount {{item.type}}">{{item.type === 'income' ? '+' : '-'}}¥{{item.amountStr}}</view>
      </view>
    </view>
  </view>

  <!-- 导入按钮 -->
  <button class="btn-primary" bindtap="doImport" disabled="{{!parsedRecords || loading}}">
    {{loading ? '导入中...' : '确认导入 ' + (parsedRecords ? parsedRecords.total + ' 条' : '')}}
  </button>

  <!-- 导入结果 -->
  <view class="card result-card" wx:if="{{result}}">
    <view class="result-title">导入结果</view>
    <view class="result-row">总条数：{{result.total}}</view>
    <view class="result-row">新增：{{result.imported}}</view>
    <view class="result-row warn">去重跳过：{{result.skipped}}</view>
    <view class="result-row error" wx:if="{{result.errors > 0}}">解析失败：{{result.errors}}</view>
  </view>
</view>
