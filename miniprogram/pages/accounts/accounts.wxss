/* pages/accounts/accounts.wxss */
.account-row {
  display: flex;
  align-items: center;
}

.account-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 50%;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.account-info {
  flex: 1;
}

.account-name {
  font-size: 32rpx;
  font-weight: 500;
}

.account-type {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.account-balance {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.account-actions {
  display: flex;
  justify-content: flex-end;
  gap: 30rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  font-size: 26rpx;
  color: #4a90d9;
  padding: 8rpx 24rpx;
}

.action-btn.danger { color: #e74c3c; }

.add-btn {
  text-align: center;
  padding: 30rpx;
  color: #4a90d9;
  font-size: 30rpx;
  background: #fff;
  border-radius: 16rpx;
}

/* 弹窗 */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.edit-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
  max-height: 85vh;
  overflow-y: auto;
}

.edit-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 10rpx;
}

.icon-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  flex: 1;
}

.icon-option {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 36rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.icon-option.selected {
  background: #e8f1fc;
  box-shadow: 0 0 0 3rpx #4a90d9;
}

.edit-hint {
  font-size: 22rpx;
  color: #999;
  padding: 16rpx 0;
  line-height: 1.6;
}

.edit-cancel {
  text-align: center;
  padding: 24rpx;
  color: #999;
  font-size: 30rpx;
}
