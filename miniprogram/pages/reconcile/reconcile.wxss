/* pages/reconcile/reconcile.wxss */
.reconcile-header {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.header-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.reconcile-summary {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.summary-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
}

.summary-item.match { border-right: 1rpx solid #f0f0f0; }

.summary-item .count {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
}

.summary-item.match .count { color: #27ae60; }
.summary-item.mismatch .count { color: #e74c3c; }

.summary-item .label {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.reconcile-card {
  border-left: 6rpx solid #27ae60;
}

.reconcile-card.warn {
  border-left-color: #e74c3c;
}

.rc-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.rc-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 50%;
  font-size: 32rpx;
  margin-right: 16rpx;
}

.rc-info { flex: 1; }
.rc-name { font-size: 30rpx; font-weight: 500; }
.rc-txcount { font-size: 24rpx; color: #999; margin-left: 10rpx; }

.rc-status { font-size: 24rpx; font-weight: 500; }
.rc-status.ok { color: #27ae60; }
.rc-status.warn { color: #e74c3c; }

.rc-rows {
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
}

.rc-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 26rpx;
}

.rc-label { color: #666; }
.rc-val { font-weight: 500; }
.rc-val.income { color: #27ae60; }
.rc-val.expense { color: #e74c3c; }

.rc-row.total {
  border-top: 1rpx solid #ddd;
  margin-top: 8rpx;
  padding-top: 12rpx;
  font-weight: 600;
}

.rc-row.diff { opacity: 0; }
.rc-row.diff.show { opacity: 1; }
.rc-val.warn { color: #e74c3c; font-weight: 700; }

.rc-actions {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.rc-btn {
  background: #e8f1fc;
  color: #4a90d9;
  text-align: center;
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.rc-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
  line-height: 1.6;
}
