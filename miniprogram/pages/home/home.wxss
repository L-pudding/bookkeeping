/* pages/home/home.wxss */
.balance-card {
  background: linear-gradient(135deg, #4a90d9 0%, #5ba0e9 100%);
  color: #fff;
  text-align: center;
  padding: 40rpx 30rpx;
}

.balance-label {
  font-size: 26rpx;
  opacity: 0.85;
}

.balance-amount {
  font-size: 56rpx;
  font-weight: 700;
  margin: 10rpx 0;
}

.balance-sub {
  font-size: 24rpx;
  opacity: 0.8;
}

.type-switch {
  display: flex;
  background: #f0f0f0;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 30rpx;
}

.type-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #666;
}

.type-btn.active {
  background: #fff;
  color: #4a90d9;
  font-weight: 500;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.08);
}

.amount-input {
  display: flex;
  align-items: baseline;
  padding: 20rpx 0 30rpx;
  border-bottom: 1rpx solid #eee;
}

.amount-input .currency {
  font-size: 40rpx;
  color: #333;
  margin-right: 10rpx;
}

.amount-field {
  flex: 1;
  font-size: 56rpx;
  font-weight: 600;
}

/* 弹窗 */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.picker {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
  max-height: 70vh;
  overflow-y: auto;
}

.picker-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.picker-item {
  padding: 24rpx 20rpx;
  font-size: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.picker-item.selected {
  color: #4a90d9;
  font-weight: 500;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 0;
}

.category-item {
  width: 25%;
  text-align: center;
  padding: 20rpx 0;
}

.category-icon {
  font-size: 48rpx;
}

.category-name {
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
}

.category-item.selected .category-name {
  color: #4a90d9;
  font-weight: 500;
}

.picker-cancel {
  text-align: center;
  padding: 24rpx;
  font-size: 30rpx;
  color: #999;
  border-top: 1rpx solid #eee;
  margin-top: 10rpx;
}
